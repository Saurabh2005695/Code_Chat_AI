# CodeChat Backend Environment Configuration

# Application
APP_ENV=development
SECRET_KEY=change-this-to-a-super-secret-key-32-chars-minimum
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (Default: local SQLite database)
DATABASE_URL=sqlite+aiosqlite:///./codechat.db

# Storage Directories
STORAGE_DIR=./data/repos
CHROMA_PERSIST_DIR=./data/chroma

# Embedding Model (Sentence Transformers runs locally for free)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# LLM Provider Configuration
# Choose one of: gemini | groq | ollama
LLM_PROVIDER=gemini

# Gemini API (Free tier available at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Groq API (Optional: Fast free tier at https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Ollama Local (Optional: Completely free & local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama:7b
